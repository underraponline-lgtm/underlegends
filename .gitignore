# Los temporales por carta del generador de Servidor (_sv_0.html, _sv_1.html...).
# Uno por carta a proposito: reusar el mismo revienta en Windows mientras
# Chromium lo tiene abierto -- ver 03_Servidor/generar.py.
03_Servidor/_sv_*.html
03_Servidor/_sv.html

# El volcado de KV para bot/simular.mjs: es un derivado, se baja cuando hace
# falta. No trae secretos pero tampoco tiene por que vivir en el repo.
bot/_kv_volcado.json

# Las fotos de la temporada. R2 es la fuente; esto es el espejo local que
# llena `python bot/fotos.py --espejo`. Son 10,4 MB de fotos de personas
# reales: meterlas al historial de git las vuelve permanentes, tambien para
# quien despues se vaya.
comun/fotos/

# Credenciales de OAuth para escribir el Apps Script (proyecto `liga-global`).
#
# 🔴 MISMA REGLA QUE `creds.json`: si entran al historial no alcanza con
# borrarlas en el commit siguiente — quedan para siempre y hay que rotar el
# cliente en Google Cloud.
#
# `oauth_client.json` es lo que baja la consola al crear el cliente.
# `oauth_token.json` es el refresh token que deja el flujo, y ese es el que
# de verdad da acceso: con el se escribe el Apps Script sin volver a pedir
# permiso.
oauth_client.json
oauth_token.json

# ── EL INVENTARIO DE ACCESOS ────────────────────────────────────────────
# ACCESOS.md junta TODAS las credenciales en un solo lugar. Es el archivo
# mas peligroso del repo: si entra al historial hay que rotar todo lo que
# contiene, y borrarlo en el commit siguiente NO alcanza.
ACCESOS.md


